# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed. Only placeholders belong in this file.

BASE_URL=https://ce-qa-school.devstudi.com/teach/

# --- Main QA account ---
VALID_PIN=<5-digit PIN for the QA teacher account>
VALID_PIN_2=<5-digit PIN for a SECOND, separate QA teacher account (used by the two-sessions tests)>
INVALID_PIN=<any 5-digit PIN that is NOT valid, used by negative tests>
SCHOOL_NAME=<school name as shown in the Sign In school dropdown>
SCHOOL_SEARCH_TERM=<a substring of the school name, used to search the dropdown>
USERNAME=<username for password login>
PASSWORD=<password for password login>

# --- Module 02 (New User Flow) ---
# A brand-new QA user that has NEVER logged in (still on the default first-login password "classedge"), plus the
# password and PIN to set for it. The flow permanently changes that account, so it can be run ONCE per fresh user:
# have an admin reset the user (or create a new one) before each run. NEW-03 also needs a user who has never chosen a
# class. Leave these unset to skip Module 02.
NEW_USER_USERNAME=<username of the fresh user>
NEW_USER_NEW_PASSWORD=<the password to set during the forced reset>
NEW_USER_PIN=<a 5-digit PIN to set>
# Only if the fresh user belongs to a different school from the main account (search substring of that school's name).
NEW_USER_SCHOOL_SEARCH_TERM=<optional>

# --- Optional ---
# Full path to "Tata ClassEdge School.exe" if it is not in the default install location.
# CLASSEDGE_CLIENT_EXE=C:\Users\<you>\AppData\Local\Programs\tceclient\Tata ClassEdge School.exe
# Minutes for the long tests (defaults in brackets): session soak [16], idle [6], header idle [5], nav restore wait [3].
# SESSION_SOAK_MINUTES=16
# SESSION_IDLE_MINUTES=3.5
# HEADER_IDLE_MINUTES=3.5
# NAV_RESTORE_WAIT_MINUTES=3
