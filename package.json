{
  "name": "cep-v2-story-driven-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Story-driven Playwright end-to-end tests for Tata ClassEdge CEP v2's teach webapp (desktop client).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "set-server": "node scripts/set-server.js",
    "set-env": "node scripts/set-env.js",
    "discover-classmap": "node scripts/discover-classmap.js",
    "test:client": "playwright test --config=client-automation/playwright.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "core": "node scripts/run-core.js",
    "review:page": "node scripts/build-review-page.js",
    "review:merge": "node scripts/merge-review.js",
    "core:client": "node scripts/run-core.js client",
    "core:browser": "node scripts/run-core.js browser",
    "explore": "playwright test --config=playwright.explore.config.js",
    "review:project": "node scripts/review-project.js",
    "workbook": "node scripts/build-workbook.js",
    "bugs:report": "node scripts/build-bug-report.js",
    "cleanup:dry": "playwright test --config=playwright.explore.config.js tools/cleanup/remove-test-data.spec.js",
    "cleanup:apply": "node -e \"process.env.CLEANUP_APPLY=1;require('child_process').execSync('npx playwright test --config=playwright.explore.config.js tools/cleanup/remove-test-data.spec.js',{stdio:'inherit'})\""
  },
  "keywords": [],
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "xlsx": "^0.18.5"
  }
}
