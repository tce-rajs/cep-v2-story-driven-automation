# Template for a new environment profile. Copy this to <name>.env (e.g. staging.env) in this same folder, fill
# in real values, then switch to it with: npm run set-env <name>
# Actual profile files (anything except this one) are gitignored -- never commit real credentials.

BASE_URL=<https://your-server/teach/>

VALID_PIN=<5-digit PIN for the QA teacher account>
VALID_PIN_2=<5-digit PIN for a SECOND, separate QA teacher account, or leave blank>
INVALID_PIN=<any 5-digit PIN that is NOT valid, used by negative tests>
SCHOOL_NAME=<school name as shown in the Sign In school dropdown>
SCHOOL_SEARCH_TERM=<a substring of the school name, used to search the dropdown>
USERNAME=<username for password login>
PASSWORD=<password for password login>

# --- Module 02 (New User Flow) -- leave unset to skip Module 02 on this environment ---
# NEW_USER_USERNAME=
# default_password=classedge
# NEW_USER_NEW_PASSWORD=
# NEW_USER_PIN=
# NEW_USER_SCHOOL_SEARCH_TERM=
